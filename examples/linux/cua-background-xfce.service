[Unit]
Description=Isolated XFCE desktop for computer-use agents
After=default.target

[Service]
Type=simple
RuntimeDirectory=cua-background-xfce
RuntimeDirectoryMode=0700
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1600x1000x24 -nolisten tcp" /usr/bin/env -u WAYLAND_DISPLAY /usr/bin/dbus-run-session -- %h/.local/bin/cua-xfce-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
